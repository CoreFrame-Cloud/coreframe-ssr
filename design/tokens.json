{
  "name": "CoreFrame Design System v1.0",
  "colors": {
    "ink": "#0a0a0f",
    "midnight": "#12121a",
    "slate": "#1e1e28",
    "mist": "#e4e4e8",
    "cloud": "#f5f5f7",
    "cream": "#faf9f6",
    "gold": "#c8a96e",
    "coral": "#e07a5f",
    "primary": "#0a0a0f",
    "secondary": "#c8a96e",
    "accent": "#e07a5f",
    "surface": "#faf9f6",
    "surfaceDark": "#12121a"
  },
  "typography": {
    "fontHeading": "'Instrument Serif', serif",
    "fontBody": "'Inter', sans-serif",
    "fontMono": "'JetBrains Mono', monospace",
    "scale": {
      "h1": "clamp(2.8rem,6vw,5.5rem)",
      "h2": "clamp(1.8rem,3vw,3.2rem)",
      "h3": "clamp(1.3rem,2vw,1.9rem)",
      "body": "1.05rem",
      "small": "0.85rem",
      "label": "0.75rem uppercase letter-spacing:0.12em"
    }
  },
  "spacing": {
    "unit": "0.25rem",
    "tokens": {
      "xs": "0.5rem",
      "sm": "1rem",
      "md": "2rem",
      "lg": "4rem",
      "xl": "8rem",
      "2xl": "12rem",
      "3xl": "16rem"
    }
  },
  "radius": {
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "2rem",
    "pill": "9999px"
  },
  "elevation": {
    "soft": "0 8px 30px rgba(10,10,15,0.08)",
    "sharp": "0 2px 10px rgba(10,10,15,0.15)"
  },
  "motion": {
    "easeOut": "cubic-bezier(0.22,1,0.36,1)",
    "durationFast": "180ms",
    "durationBase": "300ms",
    "durationSlow": "600ms"
  }
}